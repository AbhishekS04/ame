# Build output
build/
app/build/
.gradle/
local.properties

# Fetched, not vendored (see fetchBungee in app/build.gradle.kts)
native-dsp/bungee/

# Cross-compiled by cargoBuild
app/src/main/jniLibs/
native/target/

# Native build scratch (CMake/Ninja, regenerated by every build)
app/.cxx/

# Local agent settings: machine-specific, and no business in a public repo
.claude/
.agents/
.qoder/
.qwen/
/skills/
/skills-lock.json
.commandcode/

# Internal reverse-engineering dossiers and private developer working files
rea/
imp_docs/



# Signing. The keystore and its passwords never go near the repository.
*.jks
*.keystore
keystore.properties

# IDE
.vscode/
.idea/
.kotlin/
*.iml
.DS_Store

# Network captures taken while reverse-engineering. They hold session
# headers, so they stay on the machine that made them. Whatever they are
# named: a capture saved as .txt is still a capture.
*.har
*.har.txt

# Design inspiration scraps
inspo-ame/

# Local-only audio diagnostics
/scripts/check_lossless.py
/scripts/tests/test_check_lossless.py
__pycache__/
*.py[cod]
